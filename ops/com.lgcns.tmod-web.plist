<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd: keep the web app alive across logins. Install: cp ops/com.lgcns.tmod-web.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.lgcns.tmod-web.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.lgcns.tmod-web</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>-lc</string><string>set -a && source ops/.env && set +a && exec uv run uvicorn tmod.web.app:app --host 0.0.0.0 --port 8090</string></array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/scmitteam/orca/projects/open-tmod/data/web.log</string>
  <key>StandardErrorPath</key><string>/Users/scmitteam/orca/projects/open-tmod/data/web.log</string>
</dict></plist>
