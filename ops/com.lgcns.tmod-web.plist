<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd: web app, kept alive. Install: ops/install_launchd.sh -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.lgcns.tmod-web</string>
  <key>WorkingDirectory</key><string>/Users/scmitteam/orca/projects/open-tmod</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>-c</string><string>set -a; source ops/.env; set +a; exec /opt/homebrew/bin/uv run uvicorn tmod.web.app:app --host 0.0.0.0 --port 8090</string></array>
